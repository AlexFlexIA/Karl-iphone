# Générer deux secrets distincts ; ne jamais les committer.
KARL_ACCESS_TOKEN=
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
# Facultatif : KARL_DB_PATH=./karl.db
# Lecture seule des crons : dossier du profil personnel, aucun appel au scheduler.
# Vide = dashboards non configurés. Sur le même VPS, laisser SSH vide.
HERMES_CRON_DIR=
# Depuis un Mac : alias SSH existant, clés et known_hosts déjà configurés.
HERMES_CRON_SSH_HOST=
# Facultatif : compte propriétaire, via sudo -n -u (droits préexistants requis).
HERMES_CRON_READ_USER=
