# Générer deux secrets distincts ; ne jamais les committer.
KARL_ACCESS_TOKEN=
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
# Facultatif : KARL_DB_PATH=./karl.db
# Lecture seule des crons : dossier du profil personnel, aucun appel au scheduler.
# Vide = dashboards non configurés. Sur le même VPS, laisser SSH vide.
HERMES_CRON_DIR=
# Depuis un Mac : alias SSH existant, clés et known_hosts déjà configurés.
HERMES_CRON_SSH_HOST=
# Facultatif : compte propriétaire, via sudo -n -u (droits préexistants requis).
HERMES_CRON_READ_USER=
# Adresse exacte ouverte par les utilisateurs (origine, sans chemin).
# Utiliser l’adresse HTTPS privée du VPS en production ; localhost pour le dev.
KARL_PUBLIC_ORIGIN=http://127.0.0.1:18000
KARL_FAMILY_OWNER_NAME=Administrateur
# Facultatif : connexion Google. Les invitations privées fonctionnent sans Google.
# Client OAuth de type application Web, redirection :
# <KARL_PUBLIC_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
